# Beget API Credentials
# Получите API пароль в панели управления Beget: https://cp.beget.com/settings/access
BEGET_LOGIN=your_beget_login
BEGET_PASSWORD=your_beget_api_password

# Server settings
PORT=3000
HOST=localhost

# Опционально: путь к SQLite (в Docker задаётся автоматически через compose)
# SQLITE_PATH=./mailboxes.db

# Доступ к генератору по приглашениям (коды хранятся только в виде SHA-256)
GENERATOR_AUTH_ENABLED=true
GENERATOR_ADMIN_INVITE=замените-на-длинный-случайный-код
GENERATOR_INVITES=

# Общий секрет для отметки активности из inbox
GENERATOR_ACTIVITY_TOKEN=замените-на-длинный-случайный-токен
